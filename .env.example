# Secrets are NAMED in config and resolved from here. Never write a value into YAML.
# Every VAR also accepts VAR_FILE, which reads the value from a file.

# --- Required ---------------------------------------------------------------
JWT_SECRET_FILE=.data/jwt.key
APP_DEK_FILE=.data/dek.key

# APP_DEK is the one that punishes a shortcut: rotate or lose it and every
# encrypted field is unreadable and every blind index stops matching. The rows
# are still there and still wrong. Keep it recoverable.

# --- Database ---------------------------------------------------------------
# Unset uses an on-disk SQLite under .data/, which is right for local work and
# wrong for any container, whose filesystem is discarded on redeploy.
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- Optional ---------------------------------------------------------------
# The reserved cross-tenant role. Server configuration alone can grant it.
# PLATFORM_ADMINS=you@example.com

# Only if this app sends. `app/config/notifications.yaml` does not exist in the
# kit — add it when you need it, and these when you add it.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
